# Backend settings
APP_NAME="MINORI Placement Intelligence"
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/runtime/minori.db
SQLITE_TIMEOUT_SECONDS=5
BACKEND_PORT=8000

# Placement reminders and internal HTTP workers. Generate a private token with bootstrap.py.
BUSINESS_TIMEZONE=Asia/Jakarta
REMINDER_DELIVERY_TIME=09:00
NOTIFICATION_DRY_RUN=true
NOTIFICATION_DELIVERY_MODE=dry_run
MAILPIT_INBOX_EMAIL=mailpit@minori.local
DEMO_NOTIFICATION_RECIPIENT=
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_MAX_SECONDS=3600
INTERNAL_API_TOKEN=
REVIEWER_API_TOKEN=

# Frontend settings
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_PORT=8501
HTTP_TIMEOUT_SECONDS=5

# Public reviewer login. PUBLIC_REVIEWER_MODE is set only by compose.public-demo.yaml.
PUBLIC_DEMO_USERNAME=
PUBLIC_DEMO_PASSWORD_HASH=
PUBLIC_DEMO_HOST=localhost
PUBLIC_SESSION_IDLE_SECONDS=900
PUBLIC_SESSION_MAX_SECONDS=3600
PUBLIC_LOGIN_MAX_ATTEMPTS=5
PUBLIC_LOGIN_WINDOW_SECONDS=300
PUBLIC_LOGIN_LOCKOUT_SECONDS=300

# Optional 9Router connection. Obtain the key and exact model ID from your router.
LLM_ENABLED=false
DEMO_CLOCK_AT=
AI_TEST_API_TOKEN=
AI_TEST_DRY_RUN=false
AI_TEST_CLOCK_AT=2026-10-14T05:00:00Z
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=
# Comma-separated exact model IDs, discovered and smoke-tested through this gateway (max 3).
NINE_ROUTER_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=30
LLM_ATTEMPT_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Docker containers use this URL to reach a router running on the host.
NINE_ROUTER_DOCKER_BASE_URL=http://host.docker.internal:20128/v1

# n8n settings. bootstrap.py generates a private encryption key in .env.
N8N_VERSION=2.43.4
N8N_ENCRYPTION_KEY=
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Bangkok

# Public interactive sandbox: generated separately in the same ignored .env.
# Keep primary INTERNAL_API_TOKEN / REVIEWER_API_TOKEN out of sandbox containers.
SANDBOX_GATEWAY_TOKEN=
SANDBOX_WORKER_TOKEN=
SANDBOX_AI_LIMIT=12
SANDBOX_WRITE_LIMIT=80
SANDBOX_EMAIL_LIMIT=5
SANDBOX_UPLOAD_LIMIT=10
