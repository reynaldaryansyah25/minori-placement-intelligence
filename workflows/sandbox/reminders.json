          },
          "conditions": [
            {
              "id": "Mode Simulasi",
              "leftValue": "={{ $json.notification.dry_run === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
