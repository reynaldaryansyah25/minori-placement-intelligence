        0
      ],
      "parameters": {
        "jsCode": "return $input.all().flatMap((item,i)=>{const c=item.json.body; const job=$('Pisahkan Pengingat').itemMatching(i).json; if(item.json.statusCode>=400||!c||!c.notification||c.notification.id!==job.notification_id||c.notification.status!=='processing'||typeof c.claim_token!=='string'||c.claim_token.length<32||c.claim_token.length>128)return []; return [{json:{session_id:job.session_id,...c},pairedItem:{item:i}}];});"
      }
    },
