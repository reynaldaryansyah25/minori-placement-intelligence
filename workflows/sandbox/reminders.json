      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item,i)=>{const c=$('Validasi Klaim').itemMatching(i).json,s=item.json;const accepted=Array.isArray(s.accepted)&&s.accepted.includes('mailpit@minori.local');const reference=typeof s.messageId==='string'?s.messageId.replace(/[^A-Za-z0-9_.:-]/g,'').slice(0,100):'';const sent=!s.error&&accepted&&Boolean(reference);return {json:{...c,smtp_sent:sent,outcome:'sent',provider_reference:sent?'mailpit:'+reference:undefined,error_code:'PROVIDER_UNAVAILABLE'},pairedItem:{item:i}};});"
      }
