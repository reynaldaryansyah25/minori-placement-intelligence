        "jsCode": "const r=$input.first().json; const sessions=(r.body||r).sessions; if(!Array.isArray(sessions))return []; return sessions.slice(0,8).filter(s=>/^[a-f0-9]{32}$/.test(s)).map(s=>({json:{session_id:s},pairedItem:{item:0}}));"
