      "parameters": {
        "jsCode": "return $input.all().flatMap((item,i)=>{if(item.json.statusCode>=400)return []; const rows=item.json.body; if(!Array.isArray(rows))return []; const sid=$('Sesi Siap').itemMatching(i).json.session_id; return rows.slice(0,5).filter(r=>typeof r.id==='string').map(r=>({json:{session_id:sid,notification_id:r.id},pairedItem:{item:i}}));});"
