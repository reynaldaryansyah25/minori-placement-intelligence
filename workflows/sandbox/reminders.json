      "name": "Validasi Tujuan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item,i)=>{const c=item.json,n=c.notification,r=c.recipient_routing,m=c.message;const approved=n.delivery_kind==='automatic'?['interview_h3','medical_h1'].includes(n.template_code):Boolean(n.approved_message&&n.approved_at&&n.approved_by);const allowed=approved&&n.managed===true&&n.dry_run===false&&r&&r.delivery_allowed===true&&r.routing_mode==='mailpit'&&r.effective_recipient==='mailpit@minori.local'&&m&&typeof m.subject==='string'&&m.subject.length>0&&m.subject.length<=160&&!/[\\r\\n]/.test(m.subject)&&typeof m.body==='string'&&m.body.length>0&&m.body.length<=8000;return {json:{...c,route_allowed:Boolean(allowed),error_code:'PROVIDER_REJECTED'},pairedItem:{item:i}};});"
      }
    },
